---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Shell Tip: Interactive Deep Directory Jumper";
const aliasString =
  "alias cj='cd $(find . -maxdepth 4 -type d 2>/dev/null | fzf)'";

const zshSnippet =
  "echo 'alias cj=\"cd \\\$(find . -maxdepth 4 -type d 2>/dev/null | fzf)\"' >> ~/.zshrc && source ~/.zshrc";
const bashSnippet =
  "echo 'alias cj=\"cd \\\$(find . -maxdepth 4 -type d 2>/dev/null | fzf)\"' >> ~/.bashrc && source ~/.bashrc";

const breakDown = [
  {
    flag: "cd",
    role: "Change Directory",
    desc: "The standard shell command to switch your current working directory terminal path.",
  },
  {
    flag: "find .",
    role: "Target Locator",
    desc: "Recursively scans your environment directory tree downward starting from your current path location.",
  },
  {
    flag: "-maxdepth 4",
    role: "Performance Cap",
    desc: "Stops the crawl at 4 layers deep to prevent terminal hangs on giant directories like node_modules.",
  },
  {
    flag: "-type d",
    role: "Type Filter",
    desc: "Restricts the output results strictly to directory folders, safely filtering out regular files.",
  },
  {
    flag: "2>/dev/null",
    role: "Noise Redirection",
    desc: "Silently discards unwanted permission or system stream tracking errors from polluting the workspace.",
  },
  {
    flag: "| fzf",
    role: "Fuzzy UI Pipe",
    desc: "Streams the paths directly into an interactive fuzzy-matching finder interface for rapid keystroke selection.",
  },
];

const distroInstalls = [
  { name: "Ubuntu / Debian", cmd: "sudo apt update && sudo apt install fzf" },
  { name: "Fedora / RHEL", cmd: "sudo dnf install fzf" },
  { name: "Arch Linux", cmd: "sudo pacman -S fzf" },
  { name: "Alpine Linux", cmd: "apk add fzf" },
];

const gitFallback =
  "git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf && ~/.fzf/install";
---

<Layout title={pageTitle}>
  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  </style>

  <div
    class="space-y-10 w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-12 selection:bg-teal-500/20 selection:text-teal-300"
  >
    <header class="space-y-4 animate-fade-in-up" style="animation-delay: 0ms;">
      <a
        href="/shellcommands"
        class="text-xs font-mono text-teal-400 hover:text-teal-300 inline-flex items-center gap-1.5 group transition-colors duration-200"
      >
        <span
          class="transform group-hover:-translate-x-0.5 transition-transform duration-200"
          >&larr;</span
        >
        ~/portfolio/shellcommands
      </a>
      <div class="space-y-3">
        <h1
          class="text-3xl md:text-4xl font-bold tracking-tight text-white font-sans"
        >
          The <span class="text-teal-400 font-mono">cj</span> Command Alias
        </h1>
        <p
          class="text-slate-400 text-sm md:text-base leading-relaxed max-w-3xl"
        >
          Tired of typing deep directory steps like <code
            class="text-teal-300 bg-slate-800/40 px-1.5 py-0.5 rounded font-mono text-xs border border-slate-700/30"
            >cd ../../../</code
          >? Run this fuzzy search utility to jump into nested code targets
          instantly with a couple of adaptive keystrokes.
        </p>
      </div>
    </header>

    <section
      class="border border-slate-850 bg-slate-900/30 rounded-xl overflow-hidden shadow-xl w-full animate-fade-in-up"
      style="animation-delay: 80ms;"
    >
      <div
        class="bg-slate-900/60 border-b border-slate-850 px-4 py-2.5 flex items-center justify-between"
      >
        <div class="flex space-x-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-slate-800"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-slate-800"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-slate-800"></div>
        </div>
        <span
          class="text-[11px] font-mono text-slate-500 tracking-wider select-none"
          >jump_alias.sh</span
        >
        <div class="w-12"></div>
      </div>
      <div
        class="p-6 font-mono text-xs md:text-sm flex items-center justify-between gap-6 w-full relative group/main-box"
      >
        <span class="text-teal-400 tracking-wide break-all select-all flex-1"
          >{aliasString}</span
        >
        <button
          id="copy-alias-btn"
          data-text={aliasString}
          class="bg-slate-900 hover:bg-slate-850 text-xs font-sans font-medium px-3.5 py-1.5 rounded-lg border border-slate-800 text-slate-300 hover:text-white transition-all duration-200 ease-out active:scale-95 shrink-0 cursor-pointer shadow-sm flex items-center gap-2"
          title="Copy alias statement"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3.5 h-3.5 main-icon-copy"
          >
            <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
            <path
              d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
            ></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3.5 h-3.5 main-icon-check hidden text-teal-400"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
          <span class="btn-text">Copy Code</span>
        </button>
      </div>
    </section>

    <section
      class="space-y-4 w-full animate-fade-in-up"
      style="animation-delay: 160ms;"
    >
      <h2
        class="text-xs font-bold tracking-widest text-slate-500 uppercase font-mono px-1 select-none"
      >
        Anatomy of the Command
      </h2>
      <div
        class="border border-slate-850 bg-slate-900/10 rounded-xl overflow-hidden font-mono text-xs w-full shadow-md"
      >
        <div
          class="hidden sm:flex items-center gap-4 border-b border-slate-850 bg-slate-900/40 p-4 text-slate-400 font-bold tracking-wider text-[11px] select-none"
        >
          <div class="w-24 shrink-0">FLAG / UTILITY</div>
          <div class="w-40 shrink-0">ROLE</div>
          <div class="flex-1 font-sans">BEHIND THE SCENES</div>
        </div>

        <div class="divide-y divide-slate-850/40 text-sm w-full">
          {
            breakDown.map((item) => (
              <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4 p-4 hover:bg-slate-900/30 transition-colors duration-150 w-full">
                <div class="w-24 shrink-0 font-bold text-teal-400 text-sm md:text-base font-mono">
                  {item.flag}
                </div>
                <div class="w-40 shrink-0 text-slate-200 font-medium font-mono text-xs sm:text-sm">
                  {item.role}
                </div>
                <div class="flex-1 text-slate-400 font-sans text-xs leading-relaxed">
                  {item.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="space-y-4 w-full animate-fade-in-up"
      style="animation-delay: 240ms;"
    >
      <h2
        class="text-xs font-bold tracking-widest text-slate-500 uppercase font-mono px-1 select-none"
      >
        Configuration Setup
      </h2>

      <div
        class="border border-slate-850 bg-slate-900/10 rounded-xl overflow-hidden w-full shadow-md"
      >
        <div
          class="flex border-b border-slate-850 bg-slate-900/40 p-1.5 gap-1.5 relative select-none"
        >
          <div
            id="tab-slider"
            class="absolute top-1.5 bottom-1.5 left-1.5 bg-slate-900 border border-slate-800 rounded-lg transition-all duration-300 ease-[cubic-bezier(0.25,1,0.5,1)] pointer-events-none"
          >
          </div>

          <button
            data-tab="zsh"
            id="btn-zsh"
            class="tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-teal-400 transition-colors duration-200 cursor-pointer"
          >
            Zsh (~/.zshrc)
          </button>
          <button
            data-tab="bash"
            id="btn-bash"
            class="tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-slate-400 hover:text-slate-200 transition-colors duration-200 cursor-pointer"
          >
            Bash (~/.bashrc)
          </button>
        </div>

        <div
          class="p-6 bg-slate-950/10 w-full relative min-h-36 overflow-hidden"
        >
          <div
            id="panel-zsh"
            class="tab-panel space-y-3 w-full transition-all duration-300 opacity-100 transform translate-x-0"
          >
            <p class="text-xs text-slate-400 leading-relaxed">
              Append directly to your shell configurations and evaluate the
              profile path:
            </p>
            <div class="relative group/snippet">
              <pre
                class="bg-slate-950/60 p-4 pr-12 rounded-lg text-xs text-teal-300 font-mono overflow-x-auto border border-slate-900 select-all leading-relaxed w-full whitespace-pre-wrap sm:whitespace-nowrap">{zshSnippet}</pre>
              <button
                class="snippet-copy-btn absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-md bg-slate-900/80 hover:bg-slate-850 border border-slate-800/80 text-slate-400 hover:text-teal-400 transition-all duration-200 active:scale-90 cursor-pointer"
                data-text={zshSnippet}
                title="Copy snippet"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5 icon-copy"
                >
                  <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
                  <path
                    d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
                  ></path>
                </svg>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5 icon-check hidden text-teal-400"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
              </button>
            </div>
          </div>

          <div
            id="panel-bash"
            class="tab-panel space-y-3 w-full absolute top-6 left-6 right-6 hidden opacity-0 transform translate-x-4 transition-all duration-300"
          >
            <p class="text-xs text-slate-400 leading-relaxed">
              Append directly to bash startup matrix profiles and load system
              parameters:
            </p>
            <div class="relative group/snippet">
              <pre
                class="bg-slate-950/60 p-4 pr-12 rounded-lg text-xs text-teal-300 font-mono overflow-x-auto border border-slate-900 select-all leading-relaxed w-full whitespace-pre-wrap sm:whitespace-nowrap">{bashSnippet}</pre>
              <button
                class="snippet-copy-btn absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-md bg-slate-900/80 hover:bg-slate-850 border border-slate-800/80 text-slate-400 hover:text-teal-400 transition-all duration-200 active:scale-90 cursor-pointer"
                data-text={bashSnippet}
                title="Copy snippet"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5 icon-copy"
                >
                  <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
                  <path
                    d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
                  ></path>
                </svg>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5 icon-check hidden text-teal-400"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="space-y-4 w-full animate-fade-in-up"
      style="animation-delay: 320ms;"
    >
      <h2
        class="text-xs font-bold tracking-widest text-slate-500 uppercase font-mono px-1 select-none"
      >
        System Core Requirement: Ecosystem Installation Matrix
      </h2>
      <p class="text-xs text-slate-400 leading-relaxed max-w-3xl px-1">
        This utility leverages <code
          class="text-slate-300 font-mono bg-slate-800/40 px-1.5 py-0.5 rounded text-xs border border-slate-700/20"
          >fzf</code
        > (fuzzy-finder) to drive the interactive query workspace layer. Ensure it
        is mapped inside your active system variables using your local package distributor:
      </p>

      <div class="grid sm:grid-cols-2 gap-4 w-full">
        {
          distroInstalls.map((distro) => (
            <div class="bg-slate-900/10 border border-slate-850 p-4 rounded-xl flex flex-col justify-between gap-3 shadow-sm hover:border-slate-800 transition-all duration-200">
              <span class="text-xs font-semibold text-slate-300 tracking-wide font-sans">
                {distro.name}
              </span>
              <div class="relative flex items-center justify-between gap-4 font-mono text-xs bg-slate-950/40 p-2.5 rounded-lg border border-slate-900/80 w-full group/distro-box">
                <span
                  class="text-teal-400/90 break-all select-all flex-1 truncate pr-2"
                  title={distro.cmd}
                >
                  {distro.cmd}
                </span>
                <button
                  class="snippet-copy-btn p-1.5 rounded bg-slate-900 hover:bg-slate-850 border border-slate-800 text-slate-400 hover:text-teal-400 transition-all duration-200 active:scale-90 cursor-pointer shrink-0"
                  data-text={distro.cmd}
                  title={`Copy ${distro.name} command`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-3 h-3 icon-copy"
                  >
                    <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-3 h-3 icon-check hidden text-teal-400"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <div
        class="bg-slate-900/10 border border-slate-850 p-5 rounded-xl space-y-3 shadow-sm hover:border-slate-800 transition-all duration-200 w-full"
      >
        <div
          class="flex items-center gap-2 text-xs font-semibold text-slate-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 text-slate-500"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          Universal Outdated Distribution Fallback (Manual Git Install)
        </div>
        <div
          class="relative flex items-center justify-between gap-4 font-mono text-xs bg-slate-950/40 p-3 rounded-lg border border-slate-900 select-all w-full group/git-box"
        >
          <pre
            class="text-teal-300 overflow-x-auto whitespace-pre-wrap sm:whitespace-nowrap flex-1 pr-6 leading-relaxed">{gitFallback}</pre>
          <button
            class="snippet-copy-btn absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-md bg-slate-900/80 hover:bg-slate-850 border border-slate-800 text-slate-400 hover:text-teal-400 transition-all duration-200 active:scale-90 cursor-pointer shrink-0"
            data-text={gitFallback}
            title="Copy universal git installation payload"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5 icon-copy"
            >
              <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
              <path
                d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
              ></path>
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5 icon-check hidden text-teal-400"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Top level configuration alias block copy trigger
  const mainCopyBtn = document.getElementById("copy-alias-btn");
  if (mainCopyBtn) {
    mainCopyBtn.addEventListener("click", async () => {
      const copyText = mainCopyBtn.getAttribute("data-text") || "";
      await navigator.clipboard.writeText(copyText);

      const iconCopy = mainCopyBtn.querySelector(".main-icon-copy");
      const iconCheck = mainCopyBtn.querySelector(".main-icon-check");
      const btnText = mainCopyBtn.querySelector(".btn-text");

      if (iconCopy && iconCheck && btnText) {
        iconCopy.classList.add("hidden");
        iconCheck.classList.remove("hidden");
        btnText.textContent = "Copied!";
        mainCopyBtn.classList.add("border-teal-500/30", "text-teal-400");

        setTimeout(() => {
          iconCopy.classList.remove("hidden");
          iconCheck.classList.add("hidden");
          btnText.textContent = "Copy Code";
          mainCopyBtn.classList.remove("border-teal-500/30", "text-teal-400");
        }, 2000);
      }
    });
  }

  // Multi-Snippet Inline Copy Button Managers (Handles tabs and distro grid automatically)
  const snippetButtons = document.querySelectorAll(".snippet-copy-btn");
  snippetButtons.forEach((btn) => {
    btn.addEventListener("click", async () => {
      const copyText = btn.getAttribute("data-text") || "";
      await navigator.clipboard.writeText(copyText);

      const iconCopy = btn.querySelector(".icon-copy");
      const iconCheck = btn.querySelector(".icon-check");

      if (iconCopy && iconCheck) {
        iconCopy.classList.add("hidden");
        iconCheck.classList.remove("hidden");
        btn.classList.add(
          "border-teal-500/40",
          "text-teal-400",
          "bg-slate-900",
        );

        setTimeout(() => {
          iconCopy.classList.remove("hidden");
          iconCheck.classList.add("hidden");
          btn.classList.remove(
            "border-teal-500/40",
            "text-teal-400",
            "bg-slate-900",
          );
        }, 2000);
      }
    });
  });

  // Interactive Tab Script Handler with Sliding Capsule Tracking Animation
  const tabButtons = document.querySelectorAll("[data-tab]");
  const panels = document.querySelectorAll(
    ".tab-panel",
  ) as NodeListOf<HTMLElement>;
  const slider = document.getElementById("tab-slider");

  const updateSliderPosition = (activeBtn: HTMLElement) => {
    if (slider) {
      slider.style.width = `${activeBtn.offsetWidth}px`;
      slider.style.left = `${activeBtn.offsetLeft}px`;
    }
  };

  const initialActive = document.getElementById("btn-zsh");
  if (initialActive) updateSliderPosition(initialActive);

  tabButtons.forEach((btn) => {
    const htmlBtn = btn as HTMLElement;
    htmlBtn.addEventListener("click", () => {
      const targetTab = htmlBtn.getAttribute("data-tab");
      updateSliderPosition(htmlBtn);

      tabButtons.forEach((b) => {
        if (b === htmlBtn) {
          b.className =
            "tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-teal-400 transition-colors duration-200 cursor-pointer";
        } else {
          b.className =
            "tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-slate-400 hover:text-slate-200 transition-colors duration-200 cursor-pointer";
        }
      });

      panels.forEach((panel) => {
        if (panel.id === `panel-${targetTab}`) {
          panel.classList.remove("hidden");
          setTimeout(() => {
            panel.classList.remove("opacity-0", "translate-x-4", "absolute");
            panel.classList.add("opacity-100", "translate-x-0");
          }, 50);
        } else {
          panel.classList.add("opacity-0", "translate-x-4", "absolute");
          panel.classList.remove("opacity-100", "translate-x-0");
          setTimeout(() => panel.classList.add("hidden"), 180);
        }
      });
    });
  });

  window.addEventListener("resize", () => {
    const currentActive = document.querySelector(
      ".tab-btn.text-teal-400",
    ) as HTMLElement;
    if (currentActive) updateSliderPosition(currentActive);
  });
</script>
