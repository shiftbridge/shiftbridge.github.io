---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Shell Tip: Quick Fix Command Alias";
const aliasString = "alias fs='sudo $(fc -ln -1)'";

const breakDown = [
  {
    flag: "fc",
    role: "Fix Command",
    desc: "The built-in shell utility used to interact with history logs.",
  },
  {
    flag: "-l",
    role: "List Format",
    desc: "Forces the command text to list directly to screen instead of booting up an editor.",
  },
  {
    flag: "-n",
    role: "No Numbers",
    desc: "Strips line numbers out of the string so it's pure shell input.",
  },
  {
    flag: "-1",
    role: "Target Last",
    desc: "Locks onto specifically the single, immediate previous line of input executed.",
  },
  {
    flag: "$( )",
    role: "Substitution",
    desc: "Evaluates the inner output text inline, feeding it directly to sudo.",
  },
];
---

<Layout title={pageTitle}>
  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  </style>

  <div class="space-y-12 w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-12">
    <header class="space-y-4 animate-fade-in-up" style="animation-delay: 0ms;">
      <a
        href="/shellcommands"
        class="text-xs font-mono text-teal-400 hover:text-teal-300 inline-flex items-center gap-1.5 group transition-colors duration-200"
      >
        <span
          class="transform group-hover:-translate-x-0.5 transition-transform duration-200"
          >&larr;</span
        >
        ~/portfolio/shellcommands
      </a>
      <div class="space-y-3">
        <h1
          class="text-3xl md:text-4xl font-bold tracking-tight text-white font-sans"
        >
          The <span class="text-teal-400 font-mono">fs</span> Command Alias
        </h1>
        <p
          class="text-slate-400 text-sm md:text-base leading-relaxed max-w-3xl"
        >
          Forgot to type <code
            class="text-teal-300 bg-slate-800/40 px-1.5 py-0.5 rounded font-mono text-xs border border-slate-700/30"
            >sudo</code
          >? Don't mash the arrow keys. Add this utility to your shell setup
          configuration to re-run your immediate last execution with root
          privileges.
        </p>
      </div>
    </header>

    <section
      class="border border-slate-850 bg-slate-900/40 rounded-xl overflow-hidden shadow-xl w-full animate-fade-in-up"
      style="animation-delay: 100ms;"
    >
      <div
        class="bg-slate-900/60 border-b border-slate-850 px-4 py-3 flex items-center justify-between"
      >
        <div class="flex space-x-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-slate-800"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-slate-800"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-slate-800"></div>
        </div>
        <span class="text-[11px] font-mono text-slate-500 tracking-wider"
          >alias_config.sh</span
        >
        <div class="w-12"></div>
      </div>
      <div
        class="p-6 font-mono text-xs md:text-sm flex items-center justify-between gap-6 w-full"
      >
        <span class="text-teal-400 tracking-wide break-all select-all flex-1"
          >{aliasString}</span
        >
        <button
          id="copy-alias-btn"
          data-text={aliasString}
          class="bg-slate-900 hover:bg-slate-850 text-xs font-sans font-medium px-4 py-2 rounded-lg border border-slate-800 text-slate-300 hover:text-white transition-all duration-200 ease-out active:scale-95 shrink-0 cursor-pointer shadow-sm ml-auto"
        >
          Copy Code
        </button>
      </div>
    </section>

    <section
      class="space-y-4 w-full animate-fade-in-up"
      style="animation-delay: 200ms;"
    >
      <h2
        class="text-xs font-bold tracking-widest text-slate-500 uppercase font-mono px-1"
      >
        Anatomy of the Command
      </h2>
      <div
        class="border border-slate-850 bg-slate-900/20 rounded-xl overflow-hidden font-mono text-xs w-full shadow-md"
      >
        <div
          class="hidden sm:flex items-center gap-4 border-b border-slate-850 bg-slate-900/50 p-4 text-slate-400 font-bold tracking-wider text-[11px]"
        >
          <div class="w-24 shrink-0">FLAG</div>
          <div class="w-40 shrink-0">ROLE</div>
          <div class="flex-1 font-sans">BEHIND THE SCENES</div>
        </div>

        <div class="divide-y divide-slate-850/60 text-sm w-full">
          {
            breakDown.map((item) => (
              <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4 p-4 hover:bg-slate-900/30 transition-colors duration-200 w-full">
                <div class="w-24 shrink-0 font-bold text-teal-400 text-sm md:text-base font-mono">
                  {item.flag}
                </div>
                <div class="w-40 shrink-0 text-slate-200 font-medium font-mono text-xs sm:text-sm">
                  {item.role}
                </div>
                <div class="flex-1 text-slate-400 font-sans text-xs leading-relaxed">
                  {item.desc}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="space-y-4 w-full animate-fade-in-up"
      style="animation-delay: 300ms;"
    >
      <h2
        class="text-xs font-bold tracking-widest text-slate-500 uppercase font-mono px-1"
      >
        Configuration Setup
      </h2>

      <div
        class="border border-slate-850 bg-slate-900/20 rounded-xl overflow-hidden w-full shadow-md"
      >
        <div
          class="flex border-b border-slate-850 bg-slate-900/50 p-1.5 gap-1.5 relative select-none"
        >
          <div
            id="tab-slider"
            class="absolute top-1.5 bottom-1.5 left-1.5 bg-slate-900 border border-slate-800 rounded-lg transition-all duration-300 ease-[cubic-bezier(0.25,1,0.5,1)] pointer-events-none"
          >
          </div>

          <button
            data-tab="zsh"
            id="btn-zsh"
            class="tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-teal-400 transition-colors duration-200 cursor-pointer"
          >
            Zsh (~/.zshrc)
          </button>
          <button
            data-tab="bash"
            id="btn-bash"
            class="tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-slate-400 hover:text-slate-200 transition-colors duration-200 cursor-pointer"
          >
            Bash (~/.bashrc)
          </button>
        </div>

        <div class="p-6 bg-slate-950/10 w-full relative min-h-32">
          <div
            id="panel-zsh"
            class="tab-panel space-y-3 w-full transition-all duration-200 opacity-100 transform translate-x-0"
          >
            <p class="text-xs text-slate-400 leading-relaxed">
              Append directly to your runtime configurations and source your
              profile environment:
            </p>
            <pre
              class="bg-slate-950/60 p-4 rounded-lg text-xs text-teal-300 font-mono overflow-x-auto border border-slate-900 select-all leading-relaxed w-full whitespace-pre-wrap sm:whitespace-nowrap">echo 'alias fs="sudo $(fc -ln -1)"' >> ~/.zshrc && source ~/.zshrc</pre>
          </div>

          <div
            id="panel-bash"
            class="tab-panel space-y-3 w-full absolute top-6 left-6 right-6 hidden opacity-0 transform translate-x-4 transition-all duration-200"
          >
            <p class="text-xs text-slate-400 leading-relaxed">
              Append to standard bash startup matrices and reload native shell
              parameters:
            </p>
            <pre
              class="bg-slate-950/60 p-4 rounded-lg text-xs text-teal-300 font-mono overflow-x-auto border border-slate-900 select-all leading-relaxed w-full whitespace-pre-wrap sm:whitespace-nowrap">echo 'alias fs="sudo $(fc -ln -1)"' >> ~/.bashrc && source ~/.bashrc</pre>
          </div>
        </div>
      </div>
    </section>

    <footer
      class="border border-slate-850 bg-slate-900/10 p-6 rounded-xl space-y-2 w-full animate-fade-in-up"
      style="animation-delay: 400ms;"
    >
      <h3
        class="text-xs font-bold text-slate-400 font-mono uppercase tracking-wider flex items-center gap-2"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
        Live Execution Test
      </h3>
      <p class="text-xs text-slate-400 leading-relaxed max-w-3xl">
        Execute an administrative file reader or directory block without root
        access (e.g., <code
          class="text-slate-300 font-mono bg-slate-800/40 px-1.5 py-0.5 rounded text-xs border border-slate-700/20"
          >fdisk -l</code
        >). Once permissions fail, enter <code
          class="text-teal-400 font-mono font-bold">fs</code
        > to auto-compile the instruction array with sudo safety headers instantly.
      </p>
    </footer>
  </div>
</Layout>

<script>
  // Clipboard Interface Management
  const copyBtn = document.getElementById("copy-alias-btn");
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      const copyText = copyBtn.getAttribute("data-text") || "";
      await navigator.clipboard.writeText(copyText);
      copyBtn.textContent = "Copied!";
      copyBtn.classList.add("border-teal-500/30", "text-teal-400");

      setTimeout(() => {
        copyBtn.textContent = "Copy Code";
        copyBtn.classList.remove("border-teal-500/30", "text-teal-400");
      }, 2000);
    });
  }

  // Interactive Tab Script Handler with Sliding Capsule Tracking Animation
  const tabButtons = document.querySelectorAll("[data-tab]");
  const panels = document.querySelectorAll(
    ".tab-panel",
  ) as NodeListOf<HTMLElement>;
  const slider = document.getElementById("tab-slider");

  // Function to lock background capsule width dynamically to button dimensions
  const updateSliderPosition = (activeBtn: HTMLElement) => {
    if (slider) {
      slider.style.width = `${activeBtn.offsetWidth}px`;
      slider.style.left = `${activeBtn.offsetLeft}px`;
    }
  };

  // Initialize position on load frame render target
  const initialActive = document.getElementById("btn-zsh");
  if (initialActive) updateSliderPosition(initialActive);

  tabButtons.forEach((btn) => {
    const htmlBtn = btn as HTMLElement;
    htmlBtn.addEventListener("click", () => {
      const targetTab = htmlBtn.getAttribute("data-tab");

      // Slide indicator plate smoothly to target button
      updateSliderPosition(htmlBtn);

      tabButtons.forEach((b) => {
        if (b === htmlBtn) {
          b.className =
            "tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-teal-400 transition-colors duration-200 cursor-pointer";
        } else {
          b.className =
            "tab-btn z-10 px-4 py-2 text-xs font-mono font-semibold rounded-lg text-slate-400 hover:text-slate-200 transition-colors duration-200 cursor-pointer";
        }
      });

      panels.forEach((panel) => {
        if (panel.id === `panel-${targetTab}`) {
          panel.classList.remove("hidden");
          // Small delay allows block allocation to process before rendering slide fade
          setTimeout(() => {
            panel.classList.remove("opacity-0", "translate-x-4", "absolute");
            panel.classList.add("opacity-100", "translate-x-0");
          }, 50);
        } else {
          panel.classList.add("opacity-0", "translate-x-4", "absolute");
          panel.classList.remove("opacity-100", "translate-x-0");
          setTimeout(() => panel.classList.add("hidden"), 200);
        }
      });
    });
  });

  // Re-adjust capsule if page window view configuration scales resizing triggers
  window.addEventListener("resize", () => {
    const currentActive = document.querySelector(
      ".tab-btn.text-teal-400",
    ) as HTMLElement;
    if (currentActive) updateSliderPosition(currentActive);
  });
</script>
