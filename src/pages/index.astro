---
import Layout from "../layouts/Layout.astro";

// Your Custom Profile Config
const name = "ShiftBridge";
const role = "Progressing through GregTech & automating systems";
const githubUrl = "https://github.com/ShiftBridge";

const techStack = ["GregTech", "Linux"];

const projects = [
  {
    title: "Shell Commands & Dotfiles",
    description:
      "A collection of highly useful custom shell aliases, utility scripts, and environment fixes to optimize everyday terminal workflows.",
    tags: ["Bash", "Linux"],
    link: "shellcommands",
  },
];
---

<Layout title={`${name} | Profile`}>
  {/* Defining the global hardware-accelerated entry keyframes */}
  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  </style>

  <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-4">
    <header
      class="space-y-4 mb-16 animate-fade-in-up"
      style="animation-delay: 0ms;"
    >
      <div
        class="inline-flex items-center space-x-2 bg-amber-500/10 text-amber-400 px-3 py-1 rounded-full text-xs font-medium border border-amber-500/20 tracking-wide font-mono"
      >
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Current Tier: Prepping MV Phase</span>
      </div>

      <h1
        class="text-4xl md:text-5xl font-bold tracking-tight text-white font-sans"
      >
        Hi, I'm <span
          class="text-transparent bg-clip-text bg-linear-to-r from-teal-400 to-cyan-400"
          >{name}</span
        >
      </h1>
      <p class="text-xl text-slate-400 font-medium max-w-2xl">
        {role}. Focused on optimizing workflows, crafting clean terminal
        environments, and building simple systemic fixes.
      </p>
      <div class="pt-2 flex gap-4">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-slate-800 hover:bg-slate-700 text-white font-medium px-4 py-2 rounded-lg border border-slate-700/60 transition-all duration-200 text-sm active:scale-95"
        >
          GitHub Profile
        </a>
        <a
          href="mailto:wait.shiftbridge@gmail.com"
          class="bg-linear-to-r from-teal-500 to-cyan-500 hover:opacity-90 text-slate-950 font-bold px-4 py-2 rounded-lg transition-all duration-200 text-sm active:scale-95"
        >
          Get In Touch
        </a>
      </div>
    </header>

    <section class="mb-16 animate-fade-in-up" style="animation-delay: 100ms;">
      <h2
        class="text-xs font-bold tracking-widest text-slate-400 uppercase mb-4 font-mono"
      >
        Skills
      </h2>
      <div class="flex flex-wrap gap-2">
        {
          techStack.map((tech) => (
            <span class="bg-slate-800/40 text-slate-300 px-3 py-1.5 rounded-md text-xs font-mono border border-slate-800 transition-colors duration-200 hover:border-slate-700/60">
              {tech}
            </span>
          ))
        }
      </div>
    </section>

    <section class="mb-24 animate-fade-in-up" style="animation-delay: 200ms;">
      <h2
        class="text-xs font-bold tracking-widest text-slate-400 uppercase mb-6 font-mono"
      >
        My Projects
      </h2>
      <div class="grid md:grid-cols-2 gap-4">
        {
          projects.map((project, index) => {
            const projectLink = project.link;
            const projectTitle = project.title;

            return (
              <div
                class="group relative bg-slate-800/20 border border-slate-800 p-6 rounded-xl hover:border-slate-700/60 hover:bg-slate-800/30 hover:-translate-y-0.5 transition-all duration-300 ease-[cubic-bezier(0.25,1,0.5,1)] flex flex-col justify-between min-h-45"
                style={`animation-delay: ${200 + index * 100}ms;`}
              >
                <div>
                  <div class="flex items-start justify-between gap-4 mb-2">
                    <h3 class="text-lg font-semibold text-white group-hover:text-teal-400 transition-colors duration-200">
                      <a
                        href={projectLink}
                        class="focus:outline-none after:absolute after:inset-0 after:rounded-xl"
                      >
                        {projectTitle}
                      </a>
                    </h3>

                    <span class="text-slate-500 group-hover:text-teal-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shrink-0 pt-1 pointer-events-none relative z-10">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-4 h-4"
                      >
                        <path d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </span>
                  </div>

                  <p class="text-sm text-slate-400 leading-relaxed mb-4">
                    {project.description}
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-2 relative z-10 pointer-events-none">
                  {project.tags.map((tag) => (
                    <span class="text-[10px] font-mono bg-slate-800/80 text-slate-400 px-2 py-0.5 rounded border border-slate-700/30 transition-colors duration-200 group-hover:border-slate-600/50">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <footer
      id="contact"
      class="border-t border-slate-800/60 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-mono animate-fade-in-up"
      style="animation-delay: 350ms;"
    >
      <p>
        LV is cool, but MV is the goal. Built using Astro, Tailwind CSS, and
        Bun.
      </p>
      <div class="flex space-x-6 relative z-20">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-300 transition-colors duration-200"
        >
          GitHub
        </a>
        <a
          href="mailto:wait.shiftbridge@gmail.com"
          class="hover:text-slate-300 transition-colors duration-200"
        >
          Email
        </a>
      </div>
    </footer>
  </div>
</Layout>
